#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 1 ]]; then
  echo "usage: $0 <package>" >&2
  exit 2
fi

package="$1"
cache_url="${NIX_PACKAGES_CACHE_URL:-https://troninster-nix-packages.cachix.org}"
cache_key="${NIX_PACKAGES_CACHE_KEY:-troninster-nix-packages.cachix.org-1:kUEt018f48FJjz0tD+1zId3VBBPePDusE0Lo2utVe7w=}"

echo "Requiring cached .#${package} from ${cache_url}"
nix build \
  --no-link \
  --print-build-logs \
  --max-jobs 0 \
  --option extra-substituters "$cache_url" \
  --option extra-trusted-public-keys "$cache_key" \
  ".#${package}"
